{
  "openapi": "3.0.3",
  "info": {
    "title": "Bloom Backend API",
    "version": "1.0.0",
    "description": "Hợp đồng API của Bloom Backend. API session-based; đăng nhập trả cookie connect.sid."
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Local development"
    }
  ],
  "tags": [
    { "name": "Auth" },
    { "name": "Public" },
    { "name": "Customer" },
    { "name": "Admin" }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Đăng nhập và tạo session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "description": "Username, email hoặc số điện thoại" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Khách hàng tự đăng ký",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CustomerRegistration" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "tags": ["Auth"],
        "summary": "Lấy hồ sơ người đăng nhập",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Đăng xuất và hủy session",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Đổi mật khẩu",
        "description": "Dùng để hoàn tất yêu cầu đổi mật khẩu tạm sau lần đăng nhập đầu.",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["oldPassword", "newPassword"],
                "properties": {
                  "oldPassword": { "type": "string", "format": "password" },
                  "newPassword": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/public/services": {
      "get": {
        "tags": ["Public"],
        "summary": "Danh sách dịch vụ đang hoạt động",
        "parameters": [
          {
            "name": "categoryGroup",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/public/services/{id}": {
      "get": {
        "tags": ["Public"],
        "summary": "Chi tiết dịch vụ đang hoạt động",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/public/staffs": {
      "get": {
        "tags": ["Public"],
        "summary": "Danh sách nhân viên đang làm việc",
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/public/professors": {
      "get": {
        "tags": ["Public"],
        "summary": "Alias danh sách nhân viên đang làm việc",
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/public/articles": {
      "get": {
        "tags": ["Public"],
        "summary": "Danh sách bài viết đã xuất bản",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/customer/overview": {
      "get": {
        "tags": ["Customer"],
        "summary": "Tổng quan tài khoản khách hàng",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/PasswordChangeRequired" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/customer/bookings": {
      "get": {
        "tags": ["Customer"],
        "summary": "Danh sách lịch hẹn của khách hàng",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["upcoming", "history"] }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/PasswordChangeRequired" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Customer"],
        "summary": "Đặt lịch hẹn",
        "description": "Ngày giờ phải hợp lệ và trong tương lai theo giờ Việt Nam. Ca: sáng 09:00-12:00, chiều 12:00-17:00, tối 17:00-22:00. Khi có staffId, nhân viên phải làm ca đó và phải còn capacity.",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookingRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/PasswordChangeRequired" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/customer/bookings/{id}/cancel": {
      "put": {
        "tags": ["Customer"],
        "summary": "Hủy lịch hẹn của khách hàng",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "reason": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/PasswordChangeRequired" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/customer/treatments": {
      "get": {
        "tags": ["Customer"],
        "summary": "Danh sách liệu trình của khách hàng",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/PasswordChangeRequired" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/dashboard/stats": {
      "get": {
        "tags": ["Admin"],
        "summary": "Thống kê dashboard",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/bookings": {
      "get": {
        "tags": ["Admin"],
        "summary": "Danh sách lịch hẹn quản trị",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "date", "in": "query", "required": false, "schema": { "type": "string", "format": "date" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "staffId", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/bookings/{id}/status": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Cập nhật trạng thái lịch hẹn",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["pending", "confirmed", "in_treatment", "completed", "cancelled"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/staffs": {
      "get": {
        "tags": ["Admin"],
        "summary": "Danh sách nhân viên",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Tạo nhân viên",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/staffs/{id}": {
      "put": {
        "tags": ["Admin"],
        "summary": "Cập nhật nhân viên",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/schedules": {
      "post": {
        "tags": ["Admin"],
        "summary": "Tạo lịch làm việc",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/pos/checkout": {
      "post": {
        "tags": ["Admin"],
        "summary": "Thanh toán POS",
        "description": "Backend lấy tên và giá từ catalog, tự tính tổng/cấn cọc/công nợ; tạo invoice, trừ kho, cập nhật ví và đối soát cọc trong MongoDB transaction. `depositDeduction` không nhận từ client; gửi `depositId` để cấn toàn bộ số tiền trong khoản cọc đang giữ.",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customerId", "items"],
                "properties": {
                  "customerId": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["itemId", "type", "quantity"],
                      "properties": {
                        "itemId": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" },
                        "type": { "type": "string", "enum": ["service", "product"] },
                        "quantity": { "type": "integer", "minimum": 1 }
                      }
                    }
                  },
                  "discountAmount": { "type": "number", "minimum": 0, "default": 0 },
                  "depositId": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" },
                  "paidAmount": { "type": "number", "minimum": 0, "description": "Số tiền thực thu; mặc định bằng finalAmount. Server tự tính debtAmount." },
                  "paymentMethod": { "type": "string", "enum": ["cash", "banking", "card", "prepaid_wallet"], "default": "cash" },
                  "isDraft": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/pos/prepaid-wallet": {
      "post": {
        "tags": ["Admin"],
        "summary": "Nạp tiền vào ví trả trước",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/customers": {
      "post": {
        "tags": ["Admin"],
        "summary": "Tạo tài khoản khách hàng",
        "description": "Tạo tài khoản với mật khẩu tạm 123456. Khách hàng phải đổi mật khẩu sau lần đăng nhập đầu.",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username"],
                "properties": {
                  "username": { "type": "string" },
                  "fullName": { "type": "string" },
                  "phone": { "type": "string" },
                  "email": { "type": "string", "format": "email" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/services": {
      "post": {
        "tags": ["Admin"],
        "summary": "Tạo dịch vụ",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/services/{id}": {
      "put": {
        "tags": ["Admin"],
        "summary": "Cập nhật dịch vụ",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Ẩn dịch vụ",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/products": {
      "post": {
        "tags": ["Admin"],
        "summary": "Tạo sản phẩm",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/products/{id}": {
      "put": {
        "tags": ["Admin"],
        "summary": "Cập nhật sản phẩm",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["success", "message", "data"],
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "nullable": true, "description": "Dữ liệu trả về phụ thuộc endpoint." }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string" },
          "data": { "nullable": true, "description": "Luôn null với error response." },
          "code": { "type": "string", "description": "Có thể có với lỗi cần đổi mật khẩu." }
        }
      },
      "CustomerRegistration": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$"
          },
          "fullName": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "BookingRequest": {
        "type": "object",
        "required": ["serviceId", "appointmentDate", "appointmentTime"],
        "properties": {
          "serviceId": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" },
          "staffId": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" },
          "appointmentDate": { "type": "string", "format": "date" },
          "appointmentTime": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
          "note": { "type": "string" }
        }
      }
    },
    "requestBodies": {
      "JsonObject": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Yêu cầu thành công.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiResponse" }
          }
        }
      },
      "BadRequest": {
        "description": "Dữ liệu hoặc định dạng request không hợp lệ.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Chưa đăng nhập hoặc session hết hạn.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Không đủ quyền hoặc cần đổi mật khẩu.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "PasswordChangeRequired": {
        "description": "Phải đổi mật khẩu tạm trước khi sử dụng API.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Không tìm thấy tài nguyên.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "Trùng dữ liệu hoặc lịch hẹn không thể đặt.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Error": {
        "description": "Lỗi máy chủ hoặc lỗi request.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
